#!/usr/bin/env bash
#
# waypoint — install, update, and migrate the Waypoint framework inside a project.
#
# Run from anywhere by whatever path reaches this script; it operates on your
# current directory by default, so the common case is:
#
#   cd your-project
#   /path/to/waypoint/waypoint install-cursor
#
# Commands:
#   install-core     Templates and skills only (no editor adapter)
#   install-claude   install-core + Claude Code adapter (.claude/rules/waypoint.md)
#   install-cursor   install-core + Cursor adapter (.cursor/rules/session-briefing.mdc)
#   update           Pull, migrate layout, refresh skills + adapter, report changes
#   update-skills    Refresh core skills only
#   migrate          Bring an older install up to the current on-disk layout
#   help             Show this message
#
# dest is the project root to install/update. Defaults to the current directory.
#
# install, update, and update-skills pull this checkout first, so you install
# what is actually current rather than whatever you last happened to fetch.
# WAYPOINT_NO_PULL=1 disables that for offline use.

set -euo pipefail

# Source locations resolve against this repo, independent of the caller's CWD.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILLS_SRC="$ROOT/skills"
TMPL_SRC="$ROOT/templates"
ADAPTERS="$ROOT/adapters"

# Core skills shipped by the framework. update/update-skills refresh exactly these;
# user-authored skills in .waypoint/skills/ are never touched.
CORE_SKILLS="new-project.md new-feature.md new-skill.md onboarding.md resume.md debug.md"

# ─── Core ────────────────────────────────────────────────────────────────────

install_core() {
	local dest="$1" wp="$1/.waypoint"

	pull_source

	echo ""
	echo "→ Creating .waypoint/ directory structure..."
	mkdir -p "$wp"/design "$wp"/plan "$wp"/features "$wp"/skills "$wp"/memory

	echo ""
	echo "→ Installing templates..."
	local f dst
	for f in opord project; do
		dst="$wp/$f.md"
		if [ ! -f "$dst" ]; then
			cp "$TMPL_SRC/$f.md" "$dst"
			echo "  + .waypoint/$f.md"
		else
			echo "  ~ .waypoint/$f.md  (exists, skipped)"
		fi
	done

	# The memory README documents the folder convention; refresh it in place.
	cp "$TMPL_SRC/memory.md" "$wp/memory/README.md"
	echo "  ✓ .waypoint/memory/README.md"

	conops_template "$dest"

	echo ""
	echo "→ Installing skills..."
	for f in $CORE_SKILLS; do
		dst="$wp/skills/$f"
		if [ ! -f "$dst" ]; then
			cp "$SKILLS_SRC/$f" "$dst"
			echo "  + .waypoint/skills/$f"
		else
			echo "  ~ .waypoint/skills/$f  (exists, skipped)"
		fi
	done

	write_revision "$dest"

	echo ""
	if [ -f "$wp/conops.md" ]; then
		echo "  CONOPS already written — nothing further to author."
	else
		echo "  Next: produce your CONOPS. Tell your assistant:"
		echo "    Read .waypoint/skills/new-project.md and follow it."
	fi
	echo ""
}

# The CONOPS template is scaffolding for writing conops.md, not a permanent
# fixture. While there is no CONOPS we keep the scaffold current so you author
# from the latest structure; once conops.md exists it has done its job and is
# removed. A shipped template that changes later is never applied to a written
# CONOPS — revising one is a deliberate act the developer has to approve.
conops_template() {
	local wp="$1/.waypoint"

	if [ ! -f "$wp/conops.md" ]; then
		cp "$TMPL_SRC/conops.md" "$wp/conops-template.md"
		echo "  ✓ .waypoint/conops-template.md"
	elif [ -f "$wp/conops-template.md" ]; then
		rm "$wp/conops-template.md"
		echo "  - .waypoint/conops-template.md  (scaffolding — conops.md is written)"
	fi
}

# There is no reliable way to detect which editor you're using from a shell
# script — Claude Code and Cursor can both be installed on the same machine,
# and a fresh project won't have a .cursor/ or .claude/ directory yet either
# way. Rather than guess (and silently install an adapter for a tool you don't
# use), require an explicit choice.
install_ambiguous() {
	echo "Error: 'install' doesn't know which editor you're using — Claude Code" >&2
	echo "and Cursor can both be present on the same machine, and there's no" >&2
	echo "reliable way to detect which one you mean. Choose explicitly:" >&2
	echo "" >&2
	echo "  $0 install-cursor" >&2
	echo "  $0 install-claude" >&2
	exit 1
}

install_claude() {
	local dest="$1"
	install_core "$dest"
	echo "→ Installing Claude Code adapter..."
	install_claude_rule "$dest"
	echo "  + .claude/rules/waypoint.md"
	report_legacy_block "$dest" || true
	echo ""
	echo "✓ Done. In a new Claude Code session: no request → 'Ready.';"
	echo "  a question → it comes up to speed and answers it."
	echo ""
}

install_cursor() {
	local dest="$1"
	install_core "$dest"
	echo "→ Installing Cursor adapter..."
	mkdir -p "$dest/.cursor/rules"
	cp "$ADAPTERS/cursor/rules/session-briefing.mdc" "$dest/.cursor/rules/session-briefing.mdc"
	echo "  + .cursor/rules/session-briefing.mdc"
	echo ""
	echo "✓ Done. In a new Cursor session: no request → 'Ready.';"
	echo "  a question → it comes up to speed and answers it."
	echo ""
}

# ─── Claude adapter (standalone rule file, like the Cursor adapter) ──────────

# The Claude briefing is a plain rule file that loads every session. Install and
# update are a wholesale copy — it never touches the project's own CLAUDE.md.
install_claude_rule() {
	local dest="$1"
	mkdir -p "$dest/.claude/rules"
	cp "$ADAPTERS/claude/rules/waypoint.md" "$dest/.claude/rules/waypoint.md"
}

# True if a pre-rules install embedded the briefing directly in a CLAUDE.md.
has_legacy_block() {
	local dest="$1" f
	for f in "$dest/CLAUDE.md" "$dest/.claude/CLAUDE.md"; do
		[ -f "$f" ] && grep -qF "# Waypoint Session Briefing" "$f" && return 0
	done
	return 1
}

# Point out a legacy embedded block so the user can remove it. We never edit
# their CLAUDE.md automatically. Returns success if a block was found.
report_legacy_block() {
	local dest="$1" f rc=1
	for f in "$dest/CLAUDE.md" "$dest/.claude/CLAUDE.md"; do
		if [ -f "$f" ] && grep -qF "# Waypoint Session Briefing" "$f"; then
			echo "  ! Legacy briefing block in ${f#"$dest"/} is superseded by"
			echo "    .claude/rules/waypoint.md — remove it to avoid duplicated instructions."
			rc=0
		fi
	done
	return $rc
}

# ─── Migration ───────────────────────────────────────────────────────────────

# Bring an existing install up to the current layout. Idempotent.
migrate() {
	local dest="$1" wp="$1/.waypoint"

	mkdir -p "$wp"/design "$wp"/plan "$wp"/features "$wp"/skills "$wp"/memory

	# memory.md (single append-file) → memory/ (one file per session).
	if [ -f "$wp/memory.md" ]; then
		local legacy="$wp/memory/$(date +%Y-%m-%d)-legacy.md"
		mv "$wp/memory.md" "$legacy"
		echo "  ~ memory.md → memory/$(basename "$legacy")"
	fi
	cp "$TMPL_SRC/memory.md" "$wp/memory/README.md"

	conops_template "$dest"

	# Claude adapter relocation: an older install embedded the briefing in a
	# CLAUDE.md. Adopt the standalone rule file, then flag the old block.
	if has_legacy_block "$dest" && [ ! -f "$dest/.claude/rules/waypoint.md" ]; then
		install_claude_rule "$dest"
		echo "  ~ Claude adapter → .claude/rules/waypoint.md"
	fi
	report_legacy_block "$dest" || true
}

# ─── Source freshness and revision stamp ─────────────────────────────────────

# Everything is copied out of this checkout, so a stale checkout quietly installs
# stale content — `update` reports success and changes nothing. Pull first.
#
# Nothing here is fatal. A tarball download, no network, local edits, a detached
# HEAD or a fork with no upstream are all legitimate states; we say what we found
# and carry on with the files as they are. Set WAYPOINT_NO_PULL=1 to skip
# entirely (offline use, and the test suite, which must not touch your checkout).
pull_source() {
	# At most once per invocation — update pulls before refreshing skills, and
	# update_skills pulls when run standalone; the second call must not repeat it.
	if [ -n "${PULLED:-}" ]; then
		return
	fi
	PULLED=1

	echo ""
	echo "→ Checking the Waypoint checkout..."

	if [ -n "${WAYPOINT_NO_PULL:-}" ]; then
		echo "  ~ WAYPOINT_NO_PULL is set — using the checkout as-is."
		return
	fi
	if ! git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
		echo "  ~ Not a git checkout — using the files as they are on disk."
		return
	fi
	if [ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ]; then
		echo "  ! The checkout has uncommitted changes — not pulling."
		echo "    Installing from your working tree as-is."
		return
	fi
	if ! git -C "$ROOT" symbolic-ref -q HEAD >/dev/null 2>&1; then
		echo "  ! The checkout is on a detached HEAD — not pulling."
		return
	fi
	if ! git -C "$ROOT" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
		echo "  ~ No upstream branch is configured — nothing to pull."
		return
	fi

	local before after
	before="$(git -C "$ROOT" rev-parse --short HEAD)"
	if ! git -C "$ROOT" pull --ff-only --quiet 2>/dev/null; then
		echo "  ! Could not pull (offline, or the branch has diverged)."
		echo "    Continuing with the checkout at $before."
		return
	fi
	after="$(git -C "$ROOT" rev-parse --short HEAD)"

	if [ "$before" = "$after" ]; then
		echo "  ✓ Already current ($after)."
	else
		echo "  ✓ Pulled $before → $after."
	fi
}

# The revision this checkout is at, or empty if it isn't a git checkout.
source_revision() {
	git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || true
}

# Record which revision a project was installed from. This is the whole of the
# version story for now: the version *is* the source commit, so it cannot drift
# from the content the way a hand-maintained version number would.
write_revision() {
	local wp="$1/.waypoint" rev
	rev="$(source_revision)"
	if [ -z "$rev" ]; then
		return
	fi
	cat >"$wp/VERSION" <<-EOF
		# Waypoint — the source revision this project was last installed from.
		# Written by the installer; do not edit by hand.
		revision: $rev
		updated:  $(date +%Y-%m-%d)
	EOF
}

# The revision previously stamped into the project, or empty if never stamped.
installed_revision() {
	local wp="$1/.waypoint"
	if [ ! -f "$wp/VERSION" ]; then
		return
	fi
	sed -n 's/^revision:[[:space:]]*//p' "$wp/VERSION"
}

# Show what actually moved between the project's stamped revision and this
# checkout, limited to the directories whose contents get installed. The
# changelog problem, answered with the git history already on disk.
report_changes() {
	local dest="$1" from="$2" log
	if [ -z "$from" ]; then
		return
	fi
	if ! git -C "$ROOT" cat-file -e "${from}^{commit}" 2>/dev/null; then
		echo "  ~ Revision $from is not in this checkout — skipping the change list."
		return
	fi

	log="$(git -C "$ROOT" log --oneline "$from..HEAD" -- skills templates adapters 2>/dev/null || true)"
	if [ -z "$log" ]; then
		echo "  ✓ No framework content changed since $from."
		return
	fi

	echo "  Framework changes since $from:"
	echo "$log" | sed 's/^/    /'

	# The OPORD is the one file update refuses to touch, so a baseline change is
	# work the user has to do by hand. Call it out rather than burying it.
	if [ -n "$(git -C "$ROOT" log --oneline "$from..HEAD" -- templates/opord.md 2>/dev/null)" ]; then
		echo ""
		echo "  ! The OPORD baseline moved in that range — see the check below."
	fi
}

# ─── Update ──────────────────────────────────────────────────────────────────

update_skills() {
	local dest="$1" wp="$1/.waypoint"
	if [ ! -d "$wp/skills" ]; then
		echo "  Error: $wp/skills does not exist. Run install first." >&2
		exit 1
	fi

	pull_source

	echo ""
	echo "→ Updating core skills..."
	local f
	for f in $CORE_SKILLS; do
		cp "$SKILLS_SRC/$f" "$wp/skills/$f"
		echo "  ✓ .waypoint/skills/$f"
	done
	echo ""
}

update() {
	local dest="$1" wp="$1/.waypoint" from
	if [ ! -d "$wp" ]; then
		echo "  Error: $wp does not exist. Run install first." >&2
		exit 1
	fi

	# Read the stamp before pulling — it records where this project came from,
	# which is what the change list is measured against.
	from="$(installed_revision "$dest")"

	pull_source

	echo ""
	echo "→ Migrating layout if needed..."
	migrate "$dest"

	update_skills "$dest"

	echo "→ Updating adapter..."
	if [ -f "$dest/.cursor/rules/session-briefing.mdc" ]; then
		cp "$ADAPTERS/cursor/rules/session-briefing.mdc" "$dest/.cursor/rules/session-briefing.mdc"
		echo "  ✓ .cursor/rules/session-briefing.mdc"
	fi
	if [ -f "$dest/.claude/rules/waypoint.md" ]; then
		install_claude_rule "$dest"
		echo "  ✓ .claude/rules/waypoint.md"
	fi

	write_revision "$dest"

	echo ""
	echo "→ What changed..."
	report_changes "$dest" "$from"

	echo ""
	echo "→ Checking OPORD baseline..."
	opord_notice "$dest"

	echo ""
	echo "✓ Update complete."
	echo ""
}

# The OPORD is project-owned once installed (you extend it). We never rewrite it;
# we only report whether the shipped baseline has moved, and how to compare.
opord_notice() {
	local dest="$1" wp="$1/.waypoint"
	if [ ! -f "$wp/opord.md" ]; then
		return
	fi
	if diff -q "$wp/opord.md" "$TMPL_SRC/opord.md" >/dev/null 2>&1; then
		echo "  ✓ OPORD matches the shipped baseline — nothing to merge."
	else
		echo "  ! OPORD differs from the shipped baseline (expected if you extended it)."
		echo "    Review framework changes and merge by hand:"
		echo "      diff \"$wp/opord.md\" \"$TMPL_SRC/opord.md\""
	fi
}

# ─── Usage ───────────────────────────────────────────────────────────────────

usage() {
	cat <<EOF

  Waypoint

  Commands:
    install-cursor    Install with Cursor adapter
    install-claude    Install with Claude Code adapter
    install-core      Install templates and skills only (no adapter)

    update            Pull, migrate layout, refresh skills + adapter, report changes
    update-skills     Refresh core skills only
    migrate           Bring an older install up to the current layout

  Usage:
    $0 <command> [dest]

    dest is the project root to install/update. Defaults to the current
    directory — run from anywhere by cd'ing into your project first:
      cd your-project && $0 install-cursor

  Environment:
    WAYPOINT_NO_PULL=1   Don't pull this checkout before installing (offline use)

EOF
}

# ─── Dispatch ────────────────────────────────────────────────────────────────

cmd="${1:-}"

case "$cmd" in
	""|help|-h|--help)
		usage
		exit 0
		;;
esac

dest="${2:-$PWD}"

# Guard against running this from inside the waypoint checkout itself with no
# explicit dest — dest defaults to your current directory, so if you cd'd into
# the checkout to look around and then ran a bare command, you'd otherwise
# silently install waypoint into itself.
dest="$(cd "$dest" 2>/dev/null && pwd || true)"
if [ -z "$dest" ]; then
	echo "Error: destination directory does not exist: ${2:-$PWD}" >&2
	exit 1
fi
case "$dest" in
	"$ROOT"|"$ROOT"/*)
		echo "Error: destination ($dest) is inside the waypoint checkout itself ($ROOT)." >&2
		echo "" >&2
		echo "dest defaults to your current directory. cd into your project first," >&2
		echo "or pass its path explicitly:" >&2
		echo "  $ROOT/waypoint $cmd /path/to/your/project" >&2
		exit 1
		;;
esac

case "$cmd" in
	install)        install_ambiguous ;;
	install-core)   install_core "$dest" ;;
	install-claude) install_claude "$dest" ;;
	install-cursor) install_cursor "$dest" ;;
	update)         update "$dest" ;;
	update-skills)  update_skills "$dest" ;;
	migrate)
		echo ""
		echo "→ Migrating to the current layout..."
		migrate "$dest"
		echo ""
		echo "✓ Migration complete."
		echo ""
		;;
	*)
		echo "Unknown command: $cmd" >&2
		usage >&2
		exit 1
		;;
esac
